{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniBoost",
  "version": "1.0.2",
  "identifier": "app.omnifolio.omniboost",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OmniBoost",
        "width": 1240,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#07080d"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OmniFolio",
    "copyright": "OmniFolio",
    "category": "Utility",
    "shortDescription": "One-click Windows performance optimizer",
    "longDescription": "OmniBoost scans your PC, finds hardware problems and applies reversible Windows, GPU, display, network and storage optimizations for maximum FPS.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
